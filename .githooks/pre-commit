#!/bin/sh
# Amanah Healthcare - Fast Pre-Commit Dart Formatter Hook

# 1. Collect all staged .dart files (Added, Copied, Modified)
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$')

if [ -n "$STAGED_DART_FILES" ]; then
  echo "[pre-commit] Formatting staged Dart files with dart format..."
  
  # Format staged files
  dart format $STAGED_DART_FILES
  
  # Re-stage formatted files so formatting is included in the commit
  git add $STAGED_DART_FILES
  echo "[pre-commit] Staged Dart files formatted and re-staged successfully."
fi

exit 0
