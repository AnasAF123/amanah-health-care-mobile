{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Amanah Healthcare (Android - Google Play)",
      "type": "dart",
      "request": "launch",
      "program": "lib/entrypoints/android/main_google_play.dart",
      "cwd": "packages/amanah_healthcare",
      "args": [
        "--android-skip-build-dependency-validation"
      ]
    },
    {
      "name": "Android - FDroid",
      "type": "dart",
      "request": "launch",
      "program": "lib/entrypoints/android/main_fdroid.dart",
      "cwd": "packages/amanah_healthcare",
      "args": [
        "--android-skip-build-dependency-validation"
      ]
    },
    {
      "name": "iOS/macOS",
      "type": "dart",
      "request": "launch",
      "program": "lib/entrypoints/ios/main_ios.dart",
      "cwd": "packages/amanah_healthcare"
    },
    {
      "name": "Windows Desktop",
      "type": "dart",
      "request": "launch",
      "program": "lib/entrypoints/android/main_google_play.dart",
      "cwd": "packages/amanah_healthcare",
      "deviceId": "windows"
    }
  ]
}
